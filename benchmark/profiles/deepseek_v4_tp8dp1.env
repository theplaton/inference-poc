# Client side for the no-speculation control. Speculative decoding is entirely a
# server-side concern -- the same checkpoint answers on the same endpoint, and a
# request cannot tell whether the tokens were drafted -- so this profile is
# deepseek_v4_tp8dp1_speculative's in full.
#
# It exists so PROFILE=deepseek_v4_tp8dp1 works on both halves: the sweep
# exports PROFILE to the client, and a profile the client did not have would
# abort the run.
#
# Plain KEY=VALUE only -- no quoting, no shell expansion, no inline comments.

PROFILE_BASE=deepseek_v4_tp8dp1_speculative
