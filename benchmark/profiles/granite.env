# Client-side settings for the small model. Same tools, same CSVs, minutes
# instead of hours -- what this profile is for is proving the plumbing works
# before an expensive run uses it.
#
# Plain KEY=VALUE only -- no quoting, no shell expansion, no inline comments.

MODEL_ID=ibm-granite/granite-3.1-1b-a400m-instruct

# Matches the serving profile, which starts far wider than the recipe's 16
# because a 2.5 GB model leaves the KV cache almost untouched.
DEFAULT_NUM_SEQS=256

# --- smoke test ---------------------------------------------------------------
# One plain round trip: Granite's chat template has no reasoning-effort switch,
# and sending V4's chat_template_kwargs would be rejected rather than ignored.
# --all has nothing extra to add here, so it runs the same single mode.
SMOKE_MODES=plain
SMOKE_MODES_ALL=plain

TEMPERATURE=1.0
TOP_P=1.0
