# Client-side settings for DeepSeek-V4-Pro. Must name the checkpoint the server
# was started with: vLLM rejects a request for any other model.
#
# Plain KEY=VALUE only -- no quoting, no shell expansion, no inline comments.

MODEL_ID=deepseek-ai/DeepSeek-V4-Pro-0813

# The batch width the server is expected to have; used only to warn when
# CONCURRENCY is set above it. Keep in step with the serving profile.
DEFAULT_NUM_SEQS=16

# --- smoke test ---------------------------------------------------------------
# V4 exposes reasoning effort through chat_template_kwargs, so each mode is a
# different request body. Think Max is opt-in (--all) because it truncates
# unless the server was started with --max-model-len >= 393216.
SMOKE_MODES=non-think,high
SMOKE_MODES_ALL=non-think,high,max

# DeepSeek's recommendation for the 0813 release: temperature 1.0 always,
# top_p 0.95 for agentic work and 1.0 otherwise.
TEMPERATURE=1.0
TOP_P=1.0
