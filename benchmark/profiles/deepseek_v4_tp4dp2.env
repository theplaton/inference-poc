# Client side of the tp4dp2 server profile without speculation. Neither the
# parallel layout nor speculative decoding is visible over HTTP -- same
# checkpoint, same chat template, same modes, and a request cannot tell whether
# its tokens were drafted -- so this inherits everything and adds nothing.
#
# It exists because PROFILE names one file per side, and a sweep that asks for
# this server has to find both.

PROFILE_BASE=deepseek_v4_tp8dp1_speculative
