# Committed defaults for the benchmark tools -- the lowest-precedence layer.
# An argument, an exported variable or benchmark/.env overrides anything here.
#
# Plain KEY=VALUE only -- no quoting, no shell expansion, no inline comments.
#
# MODEL_ID is deliberately absent: the server decides which checkpoint is loaded,
# so there is nothing sensible to default to and the tools abort without it.

# --- endpoint -----------------------------------------------------------------
# BASE_URL is derived as http://$HOST:$PORT/v1 unless you set it explicitly.
HOST=localhost
PORT=8000
API_KEY=EMPTY

# --- throughput benchmark -----------------------------------------------------
NUM_PROMPTS=32
# Capped in practice by the server's --max-num-seqs; more just queues.
CONCURRENCY=8
RANDOM_INPUT_LEN=2048
RANDOM_OUTPUT_LEN=512
BACKEND=openai-chat
BENCH_ENDPOINT=/v1/chat/completions
PERCENTILE_METRICS=ttft,tpot,itl,e2el
# Path for the run's result JSON. Empty means the run saves nothing;
# ../benchmark_sweep.sh sets it per sweep step and builds its CSVs from them.
RESULT_FILE=

# The server-side batch limit this client expects, used only to warn when
# CONCURRENCY is set above it. Keep in step with model_serving/defaults.env.
MAX_NUM_SEQS=16

# --- smoke test ---------------------------------------------------------------
# DeepSeek's recommendation for the 0813 release: temperature 1.0 always,
# top_p 0.95 for agentic work and 1.0 otherwise.
TEMPERATURE=1.0
TOP_P=1.0
