# Committed defaults for the benchmark tools -- the lowest-precedence layer. An
# argument, an exported variable, benchmark/.env or the active profile overrides
# anything here.
#
# What belongs here is what does not change with the model. Everything that does
# -- which checkpoint to name, what the chat template understands, how wide the
# server was started -- lives in profiles/, one file per model.
#
# Plain KEY=VALUE only -- no quoting, no shell expansion, no inline comments.

# --- profile ------------------------------------------------------------------
# Which file in profiles/ supplies the model-specific settings. Match whatever
# the server was started with; ../benchmark_sweep.sh exports it so both halves
# agree without being wired together.
PROFILE=deepseek_v4_tp8dp1_speculative

# --- endpoint -----------------------------------------------------------------
# BASE_URL is derived as http://$HOST:$PORT/v1 unless you set it explicitly.
HOST=localhost
PORT=8000
API_KEY=EMPTY

# --- throughput benchmark -----------------------------------------------------
NUM_PROMPTS=32
# Capped in practice by the server's --max-num-seqs; more just queues.
CONCURRENCY=8
RANDOM_INPUT_LEN=2048
RANDOM_OUTPUT_LEN=512
BACKEND=openai-chat
BENCH_ENDPOINT=/v1/chat/completions
PERCENTILE_METRICS=ttft,tpot,itl,e2el
# Force every request to generate the full RANDOM_OUTPUT_LEN. Without it the
# model may emit EOS early and a "8192-token" run quietly measures fewer; with
# it, levels and request shapes stay comparable. 0 restores natural stopping.
IGNORE_EOS=1
# Length variance for the random dataset. 0.0 means every request is exactly
# ISL/OSL, which is what keeps a scaling curve clean; 0.3 samples +/-30% for a
# run that looks more like real traffic.
RANDOM_RANGE_RATIO=0.0
# Path for the run's result JSON. Empty means the run saves nothing;
# ../benchmark_sweep.sh sets it per sweep step and builds its CSVs from them.
RESULT_FILE=

# The batch width this client expects the server to have been started with, used
# only to warn when CONCURRENCY is set above it. Profiles set their own; this is
# the fallback for one that does not.
DEFAULT_NUM_SEQS=16

# --- GPU telemetry --------------------------------------------------------------
# Average temperature, power, SM utilization and memory utilization per GPU over
# the benchmark, one row appended per run. Empty means no polling at all, the
# same way RESULT_FILE means no JSON; ../benchmark_sweep.sh sets it per sweep
# step. Sampled only while the benchmark is running -- the server is up far
# longer than any one measurement, so polling it continuously would average the
# idle gaps into the numbers. Needs nvidia-smi on the client, so it measures the
# local node or nothing.
GPU_TELEMETRY_CSV=
# Seconds between samples. 2 gives ~14 samples on the shortest run in the sweep.
GPU_POLL_INTERVAL=2
# Value for the row's run column. The sweep passes its run number; on its own a
# run is unlabelled unless you name it.
RUN_LABEL=

# --- smoke test ---------------------------------------------------------------
# Which round trips to send, and which ones --all adds. Profiles set these,
# because a mode is a chat-template feature: plain is the only one every model
# has. Fallbacks for a profile that names none.
SMOKE_MODES=plain
SMOKE_MODES_ALL=plain
TEMPERATURE=1.0
TOP_P=1.0
