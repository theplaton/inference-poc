# Copy to .env and edit. .env is gitignored so tokens stay local.
#
# Read by both halves of the project: envfile.load_env() on the python side,
# recipe.env on the bash side. A real environment variable wins over anything
# here, so `MODEL_ID=... ./serve.sh` still works for one-offs.
#
# Plain KEY=VALUE only -- no quoting, no shell expansion, no spaces around '='.

# The small model is for exercising the generic pipeline (main.py). The
# deepseek_poc/ recipe only serves V4-Pro, so set the id it should run:
#   MODEL_ID=deepseek-ai/DeepSeek-V4-Pro-0813
MODEL_ID=ibm-granite/granite-3.1-1b-a400m-instruct
# MODEL_REVISION=main
# HF_TOKEN=
# HF_HOME=
HF_XET_HIGH_PERFORMANCE=1
