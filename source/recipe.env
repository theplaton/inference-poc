# DeepSeek-V4-Pro on an 8x H200 node.
#
# Pinned from the official vLLM recipe (updated 2026-08-14):
#   https://recipes.vllm.ai/deepseek-ai/DeepSeek-V4-Pro
#   https://recipes.vllm.ai/deepseek-ai/DeepSeek-V4-Pro/hw/h200.json
#
# Every value uses `: "${VAR:=default}"`, so anything already exported in your
# shell wins over the defaults here.

RECIPE_ENV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$RECIPE_ENV_DIR/.." && pwd)"

# --- checkpoint ---------------------------------------------------------------
# Every setting lives in .env at the repo root, so the python entrypoints read the
# same values (see envfile.py). Loaded rather than sourced: an already-exported
# variable wins, matching the `:=` defaults further down.
if [ -f "$REPO_ROOT/.env" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    key="${line%%=*}"
    [ -z "${!key+x}" ] && export "$key=${line#*=}"
  done < "$REPO_ROOT/.env"
fi
# Not asserted here: install.sh sources this file and has no use for a model id.
# serve.sh and bench.sh, which do, require it themselves.

# 0813 is the official release (supersedes the preview) and carries the fused
# DSpark draft module, which is why the floor is 0.25.0 and not the model's
# 0.20.0 baseline. Parsed out of requirements.txt so the version install.sh
# installs and the version preflight.sh checks cannot drift apart.
: "${MIN_VLLM_VERSION:=$(sed -n 's/^vllm>=\([0-9][0-9.]*\).*/\1/p' "$RECIPE_ENV_DIR/requirements.txt" 2>/dev/null)}"
: "${MIN_VLLM_VERSION:?could not read a 'vllm>=X.Y.Z' line from $RECIPE_ENV_DIR/requirements.txt}"

# Checkpoint footprint the recipe reports for every V4-Pro variant.
: "${CHECKPOINT_VRAM_GB:=960}"
# ~893 GB of shards for the fused 0813 checkpoint; leave room for the download.
: "${CHECKPOINT_DISK_GB:=950}"

# --- model cache --------------------------------------------------------------
# download.py lands the shards in the repo-local cache (prepare_model.py's
# REPO_HUB_CACHE), but vLLM reads HF_HUB_CACHE and otherwise falls back to
# ~/.cache/huggingface/hub -- a different directory, so serving would re-download
# all ~893 GB. Pin both to the same path.
: "${HF_HUB_CACHE:=$REPO_ROOT/.hf-cache/hub}"
export HF_HUB_CACHE

# install.sh owns this environment. Put its tools on the scripts' PATH so JIT
# subprocesses (FlashInfer invokes `ninja`) work without shell activation.
: "${VENV_BIN:=$REPO_ROOT/venv/bin}"
case ":$PATH:" in
  *":$VENV_BIN:"*) ;;
  *) export PATH="$VENV_BIN:$PATH" ;;
esac
: "${VLLM_BIN:=$VENV_BIN/vllm}"

# --- parallelism --------------------------------------------------------------
# tep = tensor + expert parallel  (--tensor-parallel-size 8, recipe default)
# dep = data  + expert parallel   (--data-parallel-size 8, the guide's DP+EP)
: "${STRATEGY:=tep}"
: "${GPU_COUNT:=8}"

# --- Hopper memory envelope ---------------------------------------------------
# 1128 GB node - ~960 GB of weights leaves ~168 GB for KV, so context and batch
# are both held down. Raising either is the first thing that will OOM you.
: "${MAX_MODEL_LEN:=200000}"
: "${GPU_MEMORY_UTILIZATION:=0.95}"
: "${MAX_NUM_SEQS:=16}"

# --- serving ------------------------------------------------------------------
: "${HOST:=0.0.0.0}"
: "${PORT:=8000}"
: "${VLLM_DOCKER_IMAGE:=vllm/vllm-openai:latest}"
