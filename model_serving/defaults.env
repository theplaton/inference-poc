# Committed defaults for the model_serving tools -- the lowest-precedence layer.
# An argument, an exported variable or model_serving/.env overrides anything here.
#
# Pinned from the official vLLM recipe (updated 2026-08-14):
#   https://recipes.vllm.ai/deepseek-ai/DeepSeek-V4-Pro
#   https://recipes.vllm.ai/deepseek-ai/DeepSeek-V4-Pro/hw/h200.json
#
# Plain KEY=VALUE only -- no quoting, no shell expansion, no inline comments.
#
# MODEL_ID is deliberately absent: there is no sane default checkpoint, so the
# tools that need one abort instead of guessing. Put it in .env.

MODEL_REVISION=main

# --- parallelism --------------------------------------------------------------
# tep = tensor + expert parallel  (--tensor-parallel-size 8, recipe default)
# dep = data  + expert parallel   (--data-parallel-size 8, the guide's DP+EP)
STRATEGY=tep
GPU_COUNT=8

# --- Hopper memory envelope ---------------------------------------------------
# 1128 GB node - ~960 GB of weights leaves ~168 GB for KV, so context and batch
# are both held down. Raising either is the first thing that will OOM you.
MAX_MODEL_LEN=200000
GPU_MEMORY_UTILIZATION=0.95
MAX_NUM_SEQS=16

# --- serving ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Weights load + compile takes ~10-20 min before /health answers.
HEALTH_TIMEOUT=1800
# Grace period the engine gets to release GPU memory on shutdown.
SHUTDOWN_TIMEOUT=30

# --- preflight ----------------------------------------------------------------
# Checkpoint footprint the recipe reports for every V4-Pro variant.
CHECKPOINT_VRAM_GB=960
# ~893 GB of shards for the fused 0813 checkpoint; leave room for the download.
CHECKPOINT_DISK_GB=950
# native or docker -- which runtime preflight.sh should check for.
RUNTIME=native
VLLM_DOCKER_IMAGE=vllm/vllm-openai:latest

# --- cleanup ------------------------------------------------------------------
# Seconds between TERM and KILL when stopping vLLM processes.
VLLM_CLEANUP_TIMEOUT=15

# --- download -----------------------------------------------------------------
# V4-Pro is served with --trust-remote-code, so its custom modelling code (*.py)
# has to come down with the shards. Set 0 for a plain weights-only checkpoint.
DOWNLOAD_REMOTE_CODE=1
HF_XET_HIGH_PERFORMANCE=1
