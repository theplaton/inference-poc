# DeepSeek-V4-Pro on an 8x H200 node, per the official recipe (updated
# 2026-08-14):
#   https://recipes.vllm.ai/deepseek-ai/DeepSeek-V4-Pro
#   https://recipes.vllm.ai/deepseek-ai/DeepSeek-V4-Pro/hw/h200.json
#
# Two kinds of line. KEY=VALUE is a setting, and can be overridden per run from
# the command line or the environment. A line starting with -- is an engine
# argument, passed to `vllm serve` exactly as written: flag and value split on
# the first run of whitespace and no further, so the JSON below needs no quoting.
#
# Which is which follows from whether you would ever want to change it for one
# run: MAX_MODEL_LEN is a setting because sweeps retune it, the tokenizer mode is
# an argument because a checkpoint that needed a different one would be a
# different profile.
#
# KEY=VALUE lines take no quoting and no shell expansion, and no inline comments.

MODEL_ID=deepseek-ai/DeepSeek-V4-Pro-0813
MODEL_REVISION=main

# --- parallelism --------------------------------------------------------------
# TP_SIZE x DP_SIZE must equal GPU_COUNT. The recipe's layout is TP8/DP1: the
# dense layers split eight ways, one rank, experts sharded across all of it.
#
# The experts are 96.6% of this checkpoint (803 of 831 GiB), so EXPERT_PARALLEL
# is what makes it fit at all -- it shards them across TP x DP regardless of how
# those two divide. TP then only divides the 28 GiB that is left, which is why
# lowering it costs little and buys a second KV pool: see the deepseek_v4_tp4dp2_speculative
# and deepseek_v4_tp2dp4_speculative profiles.
TP_SIZE=8
DP_SIZE=1
EXPERT_PARALLEL=1
GPU_COUNT=8

# --- Hopper memory envelope ---------------------------------------------------
# 1128 GB node - ~960 GB of weights leaves ~168 GB for KV, so context and batch
# are both held down. Raising either is the first thing that will OOM you.
MAX_MODEL_LEN=200000
GPU_MEMORY_UTILIZATION=0.95
DEFAULT_NUM_SEQS=16

# Weights load + compile takes ~10-20 min before /health answers.
HEALTH_TIMEOUT=1800

# --- preflight ----------------------------------------------------------------
# Checkpoint footprint the recipe reports for every V4-Pro variant.
CHECKPOINT_VRAM_GB=960
# ~893 GB of shards for the fused 0813 checkpoint; leave room for the download.
CHECKPOINT_DISK_GB=950

# --- engine arguments ---------------------------------------------------------
# Verbatim from the recipe's h200.json, in its order, so the two can be diffed
# line by line. The Hopper overrides are the compile mode (FP4/FP8 kernels there
# need the conservative one) and flashinfer autotune off, which does not pay for
# itself on this hardware.
--trust-remote-code
--kv-cache-dtype fp8
--block-size 256
--no-enable-flashinfer-autotune
--compilation-config {"mode": 0, "cudagraph_mode": "FULL_DECODE_ONLY"}
--tokenizer-mode deepseek_v4
--tool-call-parser deepseek_v4
--enable-auto-tool-choice
--reasoning-parser deepseek_v4
--speculative-config {"method":"dspark","num_speculative_tokens":7,"draft_sample_method":"probabilistic"}
