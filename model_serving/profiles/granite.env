# Granite 3.1 1B A400M Instruct on one GPU -- the small model this repo uses to
# exercise itself. Same MoE shape as the big checkpoint (1B total, ~400M active)
# at 1/900th the weight, so a whole sweep runs in minutes instead of hours and a
# bug in the tooling costs a 30-second load rather than a 15-minute one.
#
# Nothing here is tuned for throughput; it is tuned for finishing.
#
# Plain KEY=VALUE only -- no quoting, no shell expansion, no inline comments.

MODEL_ID=ibm-granite/granite-3.1-1b-a400m-instruct
MODEL_REVISION=main

# --- parallelism --------------------------------------------------------------
# solo = one GPU, no sharding. A 2 GB model split eight ways would measure the
# interconnect rather than the model, and every rank costs a worker process.
STRATEGY=solo
GPU_COUNT=1

# --- memory envelope ----------------------------------------------------------
# The weights are ~2.5 GB, so KV is not the binding constraint here: 32k context
# and a wide batch both fit with room to spare on a 141 GB card.
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.90
DEFAULT_NUM_SEQS=256

# Seconds, not minutes: a small checkpoint loads and compiles quickly, and a
# 30-minute budget would only delay the report when something is wrong.
HEALTH_TIMEOUT=600

# --- preflight ----------------------------------------------------------------
CHECKPOINT_VRAM_GB=3
CHECKPOINT_DISK_GB=10
