# Copy to model_serving/.env and edit. .env is gitignored so tokens stay local:
#
#   cp model_serving/.env.example model_serving/.env
#
# This layer sits above defaults.env and below the real environment, so
# `MODEL_ID=... ./serve_model.sh` and `./serve_model.sh MODEL_ID=...` both still
# win over whatever is written here. See defaults.env for every other setting
# and its committed value.
#
# Plain KEY=VALUE only -- no quoting, no shell expansion, no inline comments.

# Required. The recipe pins the flags for DeepSeek-V4-Pro; 0813 is the official
# release, superseding the preview.
MODEL_ID=deepseek-ai/DeepSeek-V4-Pro-0813

# Hugging Face authentication, for gated or private repos.
HF_TOKEN=

# Hub cache. Defaults to the repo-local .hf-cache/hub so the PoC is
# self-contained; point it at a mounted volume to survive a pod restart.
# HF_HUB_CACHE=
# HF_HOME=
