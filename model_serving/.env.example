# Copy to model_serving/.env and edit. .env is gitignored so tokens stay local:
#
#   cp model_serving/.env.example model_serving/.env
#
# This layer sits above the profile and defaults.env, and below the real
# environment, so `PROFILE=granite ./serve_model.sh` and
# `./serve_model.sh PROFILE=granite` both still win over whatever is written
# here. See defaults.env for the settings that do not change with the model, and
# profiles/ for the ones that do.
#
# Plain KEY=VALUE only -- no quoting, no shell expansion, no inline comments.

# Which model everything runs against: deepseek_v4 (the recipe) or granite (a
# small model for exercising the tools). Leave it to defaults.env unless this
# machine should always serve one of them.
# PROFILE=granite

# The profile names the checkpoint. Set this only to serve one no profile names
# -- it outranks the profile, so a value here survives a profile switch.
# MODEL_ID=deepseek-ai/DeepSeek-V4-Pro-0813

# Hugging Face authentication, for gated or private repos.
HF_TOKEN=

# Hub cache. Defaults to the repo-local .hf-cache/hub so the PoC is
# self-contained; point it at a mounted volume to survive a pod restart.
# HF_HUB_CACHE=
# HF_HOME=
